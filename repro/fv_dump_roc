FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p { solver rocALUTION; preconditioner none; tolerance 1e-06; relTol 0.01; rocPreconditioner Jacobi; rocDump true; rocDevice 0; }
    pFinal { $p; relTol 0; }
    U { solver rocALUTION; preconditioner none; tolerance 1e-06; relTol 0; rocPreconditioner Jacobi; rocDump true; rocDevice 0; }
}

PISO
{
    nCorrectors             2;
    nNonOrthogonalCorrectors 0;
    pRefCell                0;
    pRefValue               0;
}

